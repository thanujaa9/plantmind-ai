# Optional persistent data location (defaults to apps/data)
DATA_DIR=./apps/data

# Python runtime containing pypdf; required for server-side PDF extraction
PYTHON_BIN=python3

# Optional hosted Redis cache (local in-memory fallback is automatic)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional OpenAI-compatible grounded generation endpoint
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
